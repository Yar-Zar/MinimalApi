{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
     "DefaultConnection": ""
  
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_CLIENT_ID",
      "ClientSecret": "YOUR_CLIENT_ID"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      //{
      //  "Name": "File",
      //  "Args": {
      //    "restrictedToMinimumLevel": "Debug",
      //    "path": "Logs/performance-.txt",
      //    "rollingInterval": "Day",
      //    "retainedFileCountLimit": 30,
      //    "fileSizeLimitBytes": 10485760,
      //    "rollOnFileSizeLimit": true,
      //    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
      //  }
      //},
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Data Source=192.168.20.125;Initial Catalog=formc-v1-db;User ID=sa;Password=U@TdB@123!@#;TrustServerCertificate=true",
          "restrictedToMinimumLevel": "Information",
          "sinkOptionsSection": {
            "tableName": "SystemLogs",
            "autoCreateSqlTable": false
          },
          "columnOptionsSection": {
            "store": {
              "remove": [ "Properties", "MessageTemplate" ]
            },
            "additionalColumns": [
              {
                "ColumnName": "SourceContext",
                "DataType": "nvarchar",
                "DataLength": -1
              },
              {
                "ColumnName": "RequestUrl",
                "DataType": "nvarchar",
                "DataLength": 255
              },
              {
                "ColumnName": "RequestType",
                "DataType": "nvarchar",
                "DataLength": 15
              },
              {
                "ColumnName": "UserId",
                "DataType": "nvarchar",
                "DataLength": 50
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "Minimal-Api"
    }
  }
}
